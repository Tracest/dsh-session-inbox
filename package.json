{
  "name": "dsh-session-inbox",
  "version": "0.5.0",
  "description": "A compact DSH session workbench with native menus, search, keyboard navigation, unread results, portable list backups, and reversible Working/Settled organization.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib",
    "vendor/LICENSE.deepseek",
    "cordis.patch.yml",
    "compatibility.json",
    "locale",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p \"test_*.py\"",
    "check": "npm run build && npm test && git diff --exit-code -- lib"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.1 <0.2.2-alpha.2 || >0.2.2-alpha.2 <1.0.0-0"
  },
  "license": "MIT",
  "author": "Tracest",
  "homepage": "https://github.com/Tracest/dsh-session-inbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tracest/dsh-session-inbox.git"
  },
  "bugs": {
    "url": "https://github.com/Tracest/dsh-session-inbox/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "sidebar",
    "workbench"
  ],
  "icon": "./assets/icon.svg"
}
