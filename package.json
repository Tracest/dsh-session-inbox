{
  "name": "dsh-session-inbox",
  "version": "0.3.1",
  "description": "A compact DSH session workbench with project groups, a Working shelf for unsettled chats, reversible Settle, and the original layout switch.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "files": [
    "lib",
    "vendor/LICENSE.deepseek",
    "cordis.patch.yml",
    "locale",
    "assets",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p \"test_*.py\"",
    "check": "npm run build && npm test && git diff --exit-code -- lib"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": "0.2.1-rc.5"
  },
  "license": "MIT",
  "author": "Tracest",
  "homepage": "https://github.com/Tracest/dsh-session-inbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tracest/dsh-session-inbox.git"
  },
  "bugs": {
    "url": "https://github.com/Tracest/dsh-session-inbox/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "sidebar",
    "workbench"
  ],
  "icon": "./assets/icon.svg"
}
