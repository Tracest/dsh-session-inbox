  "plugins": [
    {
      "name": "dsh-session-inbox",
      "title": {
        "en": "DSH Session Workbench",
        "zh": "DSH 会话工作台"
      },
      "description": {
        "en": "Compact session workbench with rounded monochrome icons, a floating Undo notice, lower Working/Settled shelves, native menus, search, keyboard navigation, metadata backups and an original-layout switch. Chinese UI. Version 0.4.4 targets DSH 0.2.2-rc.1. Isolated Windows Web checks cover startup, menus, Settle/restore, toast timing and layout switching with test session fixtures; no model API calls. Desktop interactions, macOS, Linux, mobile, live model turns and arbitrary third-party combinations remain unverified. Version 0.4.2 remains available for DSH 0.2.1-rc.5.",
        "zh": "圆角单色图标与底部浮动撤销提示，上方直接查看会话，下方收纳工作中和已整理；支持原生菜单、搜索、键盘操作、整理备份和原布局切换。中文界面。0.4.4 适配 DSH 0.2.2-rc.1，已用测试会话夹具在 Windows 隔离 Web 环境验证启动、菜单、整理/恢复、提示计时及布局切换，未调用模型 API。桌面交互、macOS、Linux、手机、真实模型对话及任意第三方插件组合仍未验收。DSH 0.2.1-rc.5 可继续使用 0.4.2。"
      },
      "author": "Tracest",
      "homepage": "https://github.com/Tracest/dsh-session-inbox",
